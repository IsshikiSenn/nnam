import platform/dialog
import std/crypto
import std/encoding
import std/fs
import ./converter.{NcmExportResult}

component BatchProgressFixture {
  state progress = BatchProgress(total: 3)

  BatchProgressDetails(progress)
  Button("Start two") {
    on press {
      progress.apply(.started(index: 0, input: "/music/duplicate.ncm"))
      progress.apply(.started(index: 1, input: "/music/duplicate.ncm"))
    }
  }
  Button("Fail second") {
    on press { progress.apply(.finished(index: 1, outcome: .failed("无效文件"))) }
  }
  Button("Finish first and start third") {
    on press {
      let result = NcmExportResult(destination: "duplicate.mp3", warnings: ["源文件未提供歌曲信息"])
      progress.apply(.finished(index: 0, outcome: .exported(result)))
      progress.apply(.started(index: 2, input: "/music/next.ncm"))
    }
  }
}

test "Batch progress shows both active items and counts outcomes as they arrive" {
  let app = mount(BatchProgressFixture())
  app.expect("已处理 0 / 3 个文件")
  app.expectNo("正在处理")

  app.tap("Start two")
  app.expect("正在处理")
  expect(app.texts().count(text => text == "duplicate.ncm") == 2)

  app.tap("Fail second")
  app.expect("已处理 1 / 3 个文件")
  app.expect("成功 0 个 · 失败 1 个")
  expect(app.texts().count(text => text == "duplicate.ncm") == 1)

  app.tap("Finish first and start third")
  app.expect("已处理 2 / 3 个文件")
  app.expect("成功 1 个 · 失败 1 个")
  app.expectNo("duplicate.ncm")
  app.expect("next.ncm")
}

test "Batch export UI shows each outcome and preserves the selected track" {
  let root = fs.join([fs.tempDir(), "nnam-batch-ui-{crypto.uuid()}"])
  try fs.mkdirAll(root)
  defer { try? fs.removeAll(root) }
  let good = fs.join([root, "good.ncm"])
  let broken = fs.join([root, "broken.ncm"])
  // NCM containing one 72-byte MPEG-2.5 frame and no tags or cover.
  let ncm = try encoding.hexDecode(
    "4354454e4644414d0000300000002cced5eb69eafb14550d45bf61dd171d6290cf6a99b42f1c5ade0c0eb31383ea4ca29d5ca412437ebc4c9ba4f47d7a78" +
      "0000000000000000000000000000000000" +
      "fb656887bc8106b41dbf1f0f88e6e4d21c855faae5a6c731fd504e5aefdeabf3dca1039d" +
      "690ca89673ed122c2d62736768deeda3dcdc9b6f1d8899ad7b2ee3952f498c3c9123e820",
  )
  let frame = try encoding.hexDecode("ffe318c0" + "00".repeat(68))
  try fs.write(good, data: ncm)
  try fs.write(broken, data: "not an NCM".bytes())

  let dialogs = dialog.fake()
  dialogs.opens = [good]
  let app = mount(ConverterScreen())
  app.tap("选择 NCM 文件…")
  await app.idle()
  app.expect("导出 MP3…")

  dialogs.opens = [good, broken]
  app.tap("批量导出…")
  await app.idle()
  app.expectNo("正在批量导出")
  app.expect("导出 MP3…")

  dialogs.folder = root
  app.tap("批量导出…")
  await app.idle()

  expect(dialogs.shown == [
    "open 选择 NCM 文件",
    "open 选择要批量导出的 NCM 文件",
    "folder 选择批量导出目录",
    "open 选择要批量导出的 NCM 文件",
    "folder 选择批量导出目录",
  ])
  app.expectNo("正在批量导出")
  app.expect("批量导出完成，成功 1 个，失败 1 个")
  app.expect("请查看失败原因，处理后可重新选择这些文件导出。")
  app.expect("已导出 good.mp3")
  app.expect("源文件未提供歌曲信息")
  app.expect("导出失败：请选择有效的 NCM 文件")
  expect(try fs.read(fs.join([root, "good.mp3"])) == frame)
  app.expectNo("导出 MP3…")

  app.openURL("file:///tmp/invalid.txt")
  await app.idle()
  app.expect("请选择 .ncm 文件")
  app.expect("批量导出完成，成功 1 个，失败 1 个")
  app.expect("已导出 good.mp3")
  if @platform == .macOS {
    app.expect("打开导出文件夹")
    expect(!app.disabled("打开导出文件夹"))
  }

  app.tap("返回曲目")
  app.expectNo("批量导出结果")
  app.expectNo("请选择 .ncm 文件")
  app.expect("导出 MP3…")
  let singleOutput = fs.join([root, "single.mp3"])
  dialogs.saveTo = singleOutput
  app.tap("导出 MP3…")
  await app.idle()
  app.expect("已导出 single.mp3")
  expect(try fs.read(singleOutput) == frame)

  let dialogCount = dialogs.shown.count()
  dialogs.saveTo = none
  app.tap("导出 MP3…")
  await app.idle()
  expect(dialogs.shown.count() == dialogCount + 1)
  app.expect("已导出 single.mp3")
  if @platform == .macOS { app.expect("在 Finder 中显示") }
  expect(!app.disabled("导出 MP3…"))

  dialogs.opens = [broken]
  app.tap("选择 NCM 文件…")
  await app.idle()
  app.expect("请选择有效的 NCM 文件")
  app.expect("请选择可读取的 NCM 文件后重试。")
  app.expect("拖入 NCM 文件")
  app.expectNo("导出 MP3…")
  app.expectNo("在 Finder 中显示")
}

test "Batch export UI shows all failures without an output folder action" {
  let root = fs.join([fs.tempDir(), "nnam-batch-ui-{crypto.uuid()}"])
  try fs.mkdirAll(root)
  defer { try? fs.removeAll(root) }
  let broken = fs.join([root, "broken.ncm"])
  try fs.write(broken, data: "not an NCM".bytes())

  let dialogs = dialog.fake()
  dialogs.opens = [broken]
  dialogs.folder = root
  let app = mount(ConverterScreen())
  app.tap("批量导出…")
  await app.idle()
  app.expect("批量导出完成，成功 0 个，失败 1 个")
  app.expect("导出失败：请选择有效的 NCM 文件")
  app.expectNo("打开导出文件夹")
  app.expectNo("在 Finder 中显示")

  app.tap("返回导入")
  app.expect("拖入 NCM 文件")
  app.expectNo("批量导出结果")
}
